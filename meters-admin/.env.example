# Базовый URL API. Относительный путь /api обслуживается прокси Vite (см. vite.config.js)
VITE_API_URL=/api
# Адрес бэкенда публичной части сайта, на который проксируются запросы /api
VITE_PROXY_TARGET=http://meters.local
# true — запросы обслуживает встроенный mock-адаптер (src/services/mockAdapter.js), бэкенд не нужен
VITE_USE_MOCKS=true
# Адрес публичной части сайта (ссылка «Публичный сайт» в меню)
VITE_PUBLIC_URL=http://meters.local/
